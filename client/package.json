{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "generate-client": "swagger-typescript-api generate -p http://localhost:5221/swagger/v1/swagger.json -o ./src/api -n Api.ts --module-name-first-tag"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "swagger-typescript-api": "^13.14.0",
    "typescript": "^7.0.2"
  }
}
